{
  "name": "angular-timezones",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "TZ=UTC ng test --watch=false",
    "test:watch": "TZ=UTC ng test",
    "test:zones": "for tz in UTC America/New_York Asia/Kathmandu Pacific/Kiritimati Australia/Lord_Howe; do echo \"=== TZ=$tz ===\"; ALLOW_ANY_TZ=1 TZ=$tz ng test --watch=false || exit 1; done"
  },
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "dependencies": {
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "rxjs": "~7.8.0",
    "shiki": "^4.4.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@tailwindcss/postcss": "^4.1.12",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher"
    ]
  }
}
